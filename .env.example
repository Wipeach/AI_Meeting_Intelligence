# 统一会议管理平台 —— 环境变量样板
# 复制为 .env 后填入真实值。请勿把 .env 提交到代码仓库。

# ============ 腾讯会议 ============
# 从原 Tencent_Meeting/腾讯会议获取.py 迁移过来，务必改为环境变量。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OPERATOR_ID=
TENCENT_APP_ID=
TENCENT_SDK_ID=

# ============ 阿里云 OSS ============
# 从 Other_Method/上传OSS.py 迁移过来，用于把腾讯会议录制转成可访问 URL。
OSS_ACCESS_ID=
OSS_ACCESS_SECRET=
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=
OSS_KEY_PREFIX=meeting/

# ============ 大模型（AI 分析）============
# 任何兼容 OpenAI Chat Completions 的服务均可。示例为智谱 GLM。
# 不配置时可用 MockLLMClient 跑通演示链路。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# ============ 邮件督办（仅手动点击发送时触发） ============
SMTP_HOST=smtp.yeah.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_TIMEOUT=20
